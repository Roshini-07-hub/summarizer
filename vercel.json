{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "installCommand": "cd frontend && npm install",
  "build": {
    "env": {
      "VITE_API_BASE": "https://summarizer-backend-kappa.vercel.app"
    }
  }
}
